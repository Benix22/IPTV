<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="32dp"
        android:paddingEnd="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajustes de la lista"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Usa una sola de estas tres opciones. Si rellenas varias, se usa primero Parrilla, después Xtream y por último la URL."
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <TextView
            style="@style/Section"
            android:text="Opción 1: Xtream (servidor, usuario y contraseña)" />

        <TextView
            style="@style/Label"
            android:text="Servidor (con puerto si lo tiene)" />

        <EditText
            android:id="@+id/xtServer"
            style="@style/Field"
            android:hint="cf.mundotechnology.xyz"
            android:inputType="textUri" />

        <TextView
            style="@style/Label"
            android:text="Usuario" />

        <EditText
            android:id="@+id/xtUser"
            style="@style/Field"
            android:inputType="text" />

        <TextView
            style="@style/Label"
            android:text="Contraseña" />

        <EditText
            android:id="@+id/xtPass"
            style="@style/Field"
            android:inputType="textPassword" />

        <TextView
            style="@style/Section"
            android:text="Opción 2: URL de la lista M3U" />

        <EditText
            android:id="@+id/listUrl"
            style="@style/Field"
            android:hint="http://servidor/get.php?username=...&amp;password=..."
            android:inputType="textUri" />

        <TextView
            style="@style/Section"
            android:text="Opción 3: servidor Parrilla" />

        <TextView
            style="@style/Label"
            android:text="Dirección del servidor" />

        <EditText
            android:id="@+id/serverUrl"
            style="@style/Field"
            android:hint="http://IP-del-VPS:3000"
            android:inputType="textUri" />

        <TextView
            style="@style/Label"
            android:text="Token (si el servidor lo tiene)" />

        <EditText
            android:id="@+id/token"
            style="@style/Field"
            android:inputType="textPassword" />

        <TextView
            style="@style/Section"
            android:text="Avanzado" />

        <TextView
            style="@style/Label"
            android:text="Identificación (User-Agent)" />

        <EditText
            android:id="@+id/userAgent"
            style="@style/Field"
            android:imeOptions="actionDone"
            android:inputType="text" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FF5468"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardar y cargar" />

            <Button
                android:id="@+id/cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Cancelar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

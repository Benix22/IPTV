<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingTop="40dp"
        android:paddingEnd="96dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajustes de la lista"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Rellena una de las dos opciones. Si indicas servidor Parrilla, se usa ese y se ignora la URL."
            android:textColor="@color/muted"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="URL de la lista M3U"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/listUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://servidor/get.php?username=...&amp;password=..."
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Servidor Parrilla (opcional)"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://IP-del-VPS:3000"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Token del servidor (si lo tiene)"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Identificación (User-Agent)"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/userAgent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FF5468"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardar y cargar" />

            <Button
                android:id="@+id/cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Cancelar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
